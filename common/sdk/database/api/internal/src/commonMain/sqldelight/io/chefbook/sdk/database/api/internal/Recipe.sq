CREATE TABLE recipes (
    recipeId TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,

    ownerId TEXT NOT NULL,
    ownerName TEXT DEFAULT NULL,
    ownerAvatar TEXT DEFAULT NULL,

    visibility TEXT NOT NULL,
    encrypted INTEGER NOT NULL DEFAULT 0,

    language TEXT DEFAULT NULL,
    description TEXT DEFAULT NULL,

    creationTimestamp TEXT NOT NULL,
    updateTimestamp TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,

    rating REAL NOT NULL DEFAULT 0.0,
    votes INTEGER NOT NULL DEFAULT 0,

    tags TEXT NOT NULL DEFAULT "{}",

    servings INTEGER DEFAULT NULL,
    time INTEGER DEFAULT NULL,

    calories INTEGER DEFAULT NULL,
    protein INTEGER DEFAULT NULL,
    fats INTEGER DEFAULT NULL,
    carbohydrates INTEGER DEFAULT NULL,

    ingredients TEXT NOT NULL,
    cooking TEXT NOT NULL,
    pictures TEXT NOT NULL DEFAULT "{}"
);

CREATE TABLE recipesScores (
    recipeId TEXT NOT NULL,
    profileId TEXT NOT NULL,
    score INTEGER DEFAULT NULL,
    FOREIGN KEY (recipeId) REFERENCES recipes(recipeId) ON DELETE CASCADE,
    UNIQUE (recipeId, profileId)
);

CREATE TABLE recipesProfiles (
    recipeId TEXT NOT NULL,
    profileId TEXT NOT NULL,
    favourite INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (recipeId) REFERENCES recipes(recipeId) ON DELETE CASCADE,
    FOREIGN KEY (profileId) REFERENCES profiles(profileId) ON DELETE CASCADE,
    UNIQUE (recipeId, profileId)
);

selectAll:
SELECT
    recipes.recipeId, recipes.name,
    recipes.ownerId, recipes.ownerName, recipes.ownerAvatar,
    (recipesProfiles.profileId == recipes.ownerId) AS owned, recipes.visibility, recipes.encrypted,
    recipes.language, recipes.description,
    recipes.creationTimestamp, recipes.updateTimestamp, recipes.version,
    recipes.rating, recipesScores.score, recipes.votes,
    recipes.tags, recipesProfiles.favourite,
    recipes.servings, recipes.time,
    recipes.calories, recipes.protein, recipes.fats, recipes.carbohydrates,
    recipes.ingredients, recipes.cooking, recipes.pictures
FROM recipesProfiles
LEFT JOIN recipes ON recipes.recipeId = recipesProfiles.recipeId
LEFT JOIN recipesScores ON recipesScores.recipeId = recipesProfiles.recipeId AND recipesScores.profileId = recipesProfiles.profileId
WHERE recipesProfiles.profileId = ?;

select:
SELECT
    recipes.recipeId, recipes.name,
    recipes.ownerId, recipes.ownerName, recipes.ownerAvatar,
    (recipesProfiles.profileId == recipes.ownerId) AS owned, recipes.visibility, recipes.encrypted,
    recipes.language, recipes.description,
    recipes.creationTimestamp, recipes.updateTimestamp, recipes.version,
    recipes.rating, recipesScores.score, recipes.votes,
    recipes.tags, COALESCE(recipesProfiles.favourite, 0) AS favourite,
    recipes.servings, recipes.time,
    recipes.calories, recipes.protein, recipes.fats, recipes.carbohydrates,
    recipes.ingredients, recipes.cooking, recipes.pictures
FROM recipes
LEFT JOIN recipesProfiles ON recipesProfiles.recipeId = recipes.recipeId
LEFT JOIN recipesScores ON recipesScores.recipeId = recipesProfiles.recipeId AND recipesScores.profileId = recipesProfiles.profileId
WHERE recipes.recipeId = ? AND recipesProfiles.profileId = ?;

getCollections:
SELECT collections.collectionId, collections.name
FROM recipesCollections
LEFT JOIN collections ON collections.collectionId = recipesCollections.collectionId
LEFT JOIN collectionsProfiles ON collectionsProfiles.collectionId = recipesCollections.collectionId
WHERE recipesCollections.recipeId = ? AND collectionsProfiles.profileId = ?;

insert:
INSERT INTO recipes (
    recipeId, name,
    ownerId, ownerName, ownerAvatar,
    visibility, encrypted,
    language, description,
    creationTimestamp, updateTimestamp, version,
    rating, votes,
    tags,
    servings, time,
    calories, protein, fats, carbohydrates,
    ingredients, cooking, pictures
)
VALUES ?;

addToRecipeBook:
INSERT INTO recipesProfiles (recipeId, profileId)
VALUES (?, ?);

setPictures:
UPDATE recipes SET pictures = ?
WHERE recipeId = ?;

getVersion:
SELECT version
FROM recipes WHERE recipeId = ?;

setVersion:
UPDATE recipes SET version = ?
WHERE recipeId = ?;

update:
UPDATE recipes
SET
    name = ?,
    ownerId = ?, ownerName = ?, ownerAvatar = ?,
    visibility = ?, encrypted = ?,
    language = ?, description = ?,
    creationTimestamp = ?, updateTimestamp = ?, version = ?,
    rating = ?, votes = ?,
    tags = ?,
    servings = ?, time = ?,
    calories = ?, protein = ?, fats = ?, carbohydrates = ?,
    ingredients = ?, cooking = ?, pictures = ?
WHERE recipeId = ?;

delete:
DELETE FROM recipes
WHERE recipeId = ?;

removeFromRecipeBook:
DELETE FROM recipesProfiles
WHERE recipeId = ? AND profileId = ?;

clearUnused:
DELETE FROM recipes
WHERE recipeId NOT IN
(
    SELECT DISTINCT recipeId
    FROM recipesProfiles
);

setFavourite:
UPDATE recipesProfiles
SET favourite = ?
WHERE recipeId = ? AND profileId = ?;

setRating:
UPDATE recipes
SET rating = ?, votes = ?
WHERE recipeId = ?;

setScore:
REPLACE INTO recipesScores (score, recipeId, profileId)
VALUES (?, ?, ?);

setOwnerInfo:
UPDATE recipes
SET ownerName = ?, ownerAvatar = ?
WHERE recipeId = ?;

setTags:
UPDATE recipes
SET tags = ?
WHERE recipeId = ?;
